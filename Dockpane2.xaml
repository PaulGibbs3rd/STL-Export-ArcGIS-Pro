<UserControl x:Class="STL_Export_Tool.Dockpane2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="12" Background="Transparent">

        <!-- Bottom bar: Status + Add Base button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
            <TextBlock Text="{Binding Status}"
                 Foreground="Gray"
                 TextWrapping="Wrap"
                 Margin="0,8,0,8"
                 IsHitTestVisible="False"/>
            <Button Content="Add Base"
              Height="32"
              Command="{Binding AddBaseCommand}" />
        </StackPanel>

        <!-- Main content (scrollable) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
            <StackPanel Orientation="Vertical">

                <!-- Header -->
                <TextBlock Text="{Binding Heading}"
                   Style="{DynamicResource Esri_TextBlockDockPaneHeader}" />

                <TextBlock Text="Select an existing STL (an open/unbased mesh) to add a watertight flat base to. The result is saved alongside the original file with a '_with_base' suffix."
                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="Gray"/>

                <!-- Input -->
                <GroupBox Header="Input STL" Margin="0,12,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="File:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox  Grid.Column="1" Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button   Grid.Column="2" Content="Browse…" Command="{Binding BrowseInputFileCommand}" />
                    </Grid>
                </GroupBox>

                <!-- Base -->
                <GroupBox Header="Base" Margin="0,12,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Base thickness (STL units):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox  Grid.Column="1" Text="{Binding BaseThickness, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
