<UserControl x:Class="STL_Export_Tool.Dockpane1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Dock layout: bottom bar is fixed, everything else scrolls -->
    <DockPanel LastChildFill="True" Margin="12" Background="Transparent">

        <!-- Bottom bar: Status + Export button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
            <TextBlock Text="{Binding Status}"
                 Foreground="Gray"
                 TextWrapping="Wrap"
                 Margin="0,8,0,8"
                 IsHitTestVisible="False"/>
            <Button Content="Export STL"
              Height="32"
              Command="{Binding ExportCommand}" />
        </StackPanel>

        <!-- Main content (scrollable) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
            <StackPanel Orientation="Vertical">

                <!-- Header -->
                <TextBlock Text="{Binding Heading}"
                   Style="{DynamicResource Esri_TextBlockDockPaneHeader}" />

                <!-- Extent -->
                <GroupBox Header="Extent" Margin="0,12,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Use Current View Extent"
                      Command="{Binding SetFromCurrentViewCommand}" Margin="0,0,8,0"/>
                            <Button Content="Draw Extent on Map"
                      Command="{Binding DrawExtentCommand}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MinX:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding MinX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MinY:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding MinY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="MaxX:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding MaxX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="MaxY:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding MaxY, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <!-- Output -->
                <GroupBox Header="Output" Margin="0,12,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4"/>
                        <Button   Grid.Row="0" Grid.Column="2" Content="Browse…" Command="{Binding BrowseFolderCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,4"/>
                        <Button   Grid.Row="1" Grid.Column="2" Content="…" Command="{Binding BrowseFileCommand}" />

                        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Single file output (.stl)"
                      IsChecked="{Binding IsSingleFileOutput}" Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Base -->
                <GroupBox Header="Base" Margin="0,12,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2"
                      Content="Add flat base (watertight)"
                      IsChecked="{Binding AddBase}"
                      Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Base thickness (ft):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox  Grid.Row="1" Grid.Column="1"
                      Text="{Binding BaseThickness, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding AddBase}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
